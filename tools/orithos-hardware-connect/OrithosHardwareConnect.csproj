<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OrithosHardwareConnect</AssemblyName>
    <RootNamespace>Orithos.HardwareConnect</RootNamespace>
    <Version>1.1.5</Version>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
    <InformationalVersion>1.1.5</InformationalVersion>
    <Description>Orithos register agent: printers, cash drawer, and local EFTPOS bridge</Description>
    <ApplicationIcon>assets\orithos-hc.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="bin/**;obj/**;dist/**;publish/**" />
    <None Remove="bin/**;obj/**;dist/**;publish/**" />
    <EmbeddedResource Include="assets\orithos-hc-logo.png" />
    <Content Include="assets\orithos-hc-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\orithos-hc.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
