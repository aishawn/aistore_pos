# Local IDE dev — copy to .env (auto-loaded by application.yml).
# Docker: root or pos-api/docker-compose.yml injects env vars; .env is not copied into the image.

# --- PostgreSQL ---
# Use the supplied POSTGRESQL_URL in deployments. The JDBC form is used by Spring.
POSTGRESQL_URL=postgresql://postgres:change-me@localhost:5432/orithos
POSTGRESQL_JDBC_URL=jdbc:postgresql://localhost:5432/orithos
DB_USER=postgres
DB_PASSWORD=change-me

# --- Redis (local: connect to orithos-redis container on host port) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=orithos-redis

# --- Backend ---
BACKEND_PORT=8080
# MUST be >= 32 bytes for HS256. Change this in production.
JWT_SECRET=change-me-to-a-32-byte-plus-production-secret-0123456789
# Comma-separated frontend origin(s) allowed to call the API (patterns OK).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://*.localhost:3000
SQL_INIT_MODE=never
# Browser origin used in invite / password-reset email links.
PUBLIC_APP_URL=http://localhost:3000
# Tenant subdomains: {slug}.APP_TENANT_BASE_DOMAIN
APP_TENANT_BASE_DOMAIN=localhost
APP_TENANT_SCHEME=http
APP_TRIAL_DAYS=14
APP_TENANT_RESERVED_SLUGS=www,app,api,odoo,cdn,support,mail,status
# Admins of this vendor can open /platform/stores on the control plane
# Pilot store host is http://demo.localhost:3000 (slug demo).
APP_PLATFORM_OPERATOR_SLUG=demo

# --- Optional SMTP (invite + forgot-password delivery) ---
# Leave MAIL_HOST empty to disable email; admins can still copy invite/reset links.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@orithos.com.au

# --- Odoo catalogue for Sommelier (optional; same service account as frontend) ---
# ODOO_BASE_URL=https://odoo.orithos.com.au
# ODOO_DATABASE=aipos_uat
# ODOO_SERVICE_USERNAME=
# ODOO_SERVICE_PASSWORD=

# --- POS AI assistant + Voice STT (optional) ---
# Use AI_PROVIDER=remote with the gateway token to route through orithos-ai-services.
# Copy this file to .env and uncomment; working directory must be pos-api.
AI_PROVIDER=remote
AI_SERVICE_BASE_URL=https://ai.orithos.com.au
AI_SERVICE_TOKEN=
# Command parsing and preview are enabled for manual testing. Execution stays
# disabled until isolated Odoo UAT and readback checks are complete.
AI_COMMANDS_ENABLED=true
AI_COMMANDS_EXECUTION_ENABLED=false
# AI_ENABLED=true
# AI_DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# AI_DASHSCOPE_MODEL=qwen-plus
# Faster classify-only model (default qwen-flash):
# AI_DASHSCOPE_CLASSIFY_MODEL=qwen-flash
# AI_DASHSCOPE_TEMPERATURE=0.1
# AI_DASHSCOPE_MAX_TOKENS=1024
# AI_DASHSCOPE_TIMEOUT_SECONDS=40
# qwen3.8-flash is OK — API auto-sets multi-model. BASE_URL must stay host-only:
# AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Optional: AI_DASHSCOPE_MULTI_MODEL=true
# Voice STT model (qwen3-asr-flash supports EN/ZH auto-detect; good for AU + Chinese staff)
# AI_TRANSCRIPTION_MODEL=qwen3-asr-flash
# Wine-label vision / OCR (Qwen-VL) — do not reuse the chat model id here
# AI_VISION_MODEL=qwen-vl-plus
# Multi-turn memory (Redis / Lettuce):
# AI_CONVERSATION_MEMORY_TURNS=6
# AI_CONVERSATION_MEMORY_TTL_MINUTES=120
# Australia / international Model Studio keys usually need the intl endpoint:
# AI_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# --- AI report: per-outlet RO schema orithos_o{outletId} (created on API startup) ---
# AI_REPORT_RO_USER=orithos_ai_ro
# AI_REPORT_RO_PASSWORD=orithos-ai-ro
# AI_REPORT_QUOTA_QUERIES=120
# AI_REPORT_QUOTA_TOKENS=200000
