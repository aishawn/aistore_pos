{
  "name": "orithos-pos-ui",
  "version": "0.4.0",
  "private": true,
  "description": "Orithos POS — Australian liquor and specialty retail front-of-house (Next.js, Orithos backend)",
  "author": "Orithos",
  "license": "UNLICENSED",
  "keywords": [
    "orithos",
    "pos",
    "retail-platform",
    "nextjs",
    "australia",
    "liquor-retail"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-pos-api-openapi.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/lib/**/*.test.ts",
    "test:unit:ci": "node --experimental-strip-types --test --test-reporter=junit --test-reporter-destination=../reports/test-runs/pos-ui.xml src/lib/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.12.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
