# pos-ui environment — choose ONE mode:
#
# Local IDE (npm run dev):
#   copy .env.local.example → .env.local
#   BACKEND_URL defaults to http://localhost:8080 if unset.
#
# Docker (root docker-compose.yml or pos-ui/docker-compose.yml):
#   use repo root .env — BACKEND_URL=http://backend:8080
#   compose sets BACKEND_URL at runtime; do NOT use localhost here.

PORT=3000
NEXT_PUBLIC_API_BASE_URL=
# Optional: external URL; browser uses /downloads/orithos-hardware-connect-latest (route) by default
NEXT_PUBLIC_ORITHOS_HC_DOWNLOAD_URL=
# Server-only: redirect download route to CDN/GitHub instead of public/downloads/*.zip
# ORITHOS_HC_DOWNLOAD_URL=
# Docker build: bake GitHub Release zip into the frontend image (docker-compose default)
# ORITHOS_HC_BUNDLE_URL=
