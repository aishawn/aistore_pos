# Local IDE dev only — copy to .env.local (gitignored).
# Docker uses root docker-compose.yml (BACKEND_URL=http://backend:8080).
# If omitted, next.config.ts defaults to http://localhost:8080.

PORT=3000
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=http://localhost:8080
# Subdomain multi-tenant ({slug}.orithos.com.au). Local: use localhost + APP_TENANT_SCHEME=http on API.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=orithos.com.au
NEXT_PUBLIC_TENANT_SCHEME=http
