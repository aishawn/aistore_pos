# Copy to .env and edit before production deployment.
# Used by the root docker-compose.yml (full Docker stack).
#
# Local IDE dev instead:
#   pos-api:  copy pos-api/.env.example → pos-api/.env
#   pos-ui:   copy pos-ui/.env.local.example → pos-ui/.env.local
#   Start PostgreSQL/Redis: docker compose up -d redis  (from repo root)
#   Run backend in IntelliJ, frontend: npm run dev

# --- PostgreSQL ---
# Supplied in Dokploy as the platform PostgreSQL connection URL.
POSTGRESQL_URL=postgresql://postgres:change-me@host:5432/postgres
POSTGRESQL_JDBC_URL=
DB_USER=postgres
DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=replace-with-a-different-long-random-password

# --- Backend ---
# Must be a unique random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Used only when creating the first admin account in a new database.
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
# Comma-separated browser origins allowed to call the API (Spring CORS; wildcards OK).
CORS_ALLOWED_ORIGINS=https://*.orithos.com.au,https://orithos.com.au,https://app.orithos.com.au
# Tenant hosts: https://{slug}.orithos.com.au
APP_TENANT_BASE_DOMAIN=orithos.com.au
APP_TENANT_SCHEME=https
APP_TRIAL_DAYS=14
# Vendor subdomain whose admins can list all stores on app.* (/platform/stores)
# Pilot store host is https://demo.orithos.com.au (slug demo).
APP_PLATFORM_OPERATOR_SLUG=demo

# --- Frontend (Docker: keep these values on Windows and Linux) ---
# MUST stay empty in Docker — browser uses same-origin /api (no localhost:8080).
NEXT_PUBLIC_API_BASE_URL=
# Next.js proxy target inside the Docker network (service name "backend").
BACKEND_URL=http://backend:8080
# Public browser URL used in invite / password-reset links (backend).
PUBLIC_APP_URL=https://pos.example.com

# --- Optional SMTP for invite / forgot-password emails ---
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@orithos.com.au

# --- Odoo integration (server-side only) ---
# Defaults for this Orithos deployment; override when the Odoo instance changes.
ODOO_BASE_URL=https://odoo.orithos.com.au
ODOO_DATABASE=aipos
# Optional but required for production auto-recover + Sommelier Odoo catalogue.
# Set BOTH in Dokploy (frontend + backend Compose env), then normal Deploy.
# Use a dedicated least-privilege Odoo POS account. Never commit the real password.
ODOO_SERVICE_USERNAME=
ODOO_SERVICE_PASSWORD=
# Keep disabled until a stocktake write passes isolated-company Odoo UAT.
ODOO_STOCKTAKE_WRITE_ENABLED=false

# --- Private Shopfront R2 archive mirror (server-side only) ---
# Keep credentials in Dokploy secrets. Rotate any key previously shared in chat.
# R2 is a private development/test archive. Scheduled sync is off by default;
# use the admin integration page's Sync now action when you want a fresh snapshot.
R2_ENDPOINT=
R2_BUCKET=generate-image
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=shopfront/
# Optional extra active-store prefixes (comma-separated). Synced under /data/tenants/{slug}/.
# Example: R2_PREFIXES=shopfront/acme/,shopfront/other/
R2_PREFIXES=
R2_DATABASE_KEY=shopfront/shopfront.sqlite3
R2_MANIFEST_KEY=shopfront/manifest.json
R2_SYNC_SCHEDULE_ENABLED=false
# Only used if scheduled sync is explicitly enabled.
R2_SYNC_TIMEZONE=Australia/Adelaide
R2_SYNC_HOUR=3
R2_SYNC_MINUTE=30
R2_RETAIN_SNAPSHOTS=2
R2_MAX_TOTAL_BYTES=2147483648

# --- AI assistant (DashScope / 阿里云百炼) ---
# Optional. Leave disabled until a real DashScope key is configured.
AI_ENABLED=false
AI_DASHSCOPE_API_KEY=
# Chat model. qwen-plus / qwen-flash use text-generation.
# qwen3.8-flash needs multimodal-generation — the API auto-routes (do not change BASE_URL).
AI_DASHSCOPE_MODEL=qwen-plus
# Lighter model for intent classify (default qwen-flash). Set empty to use chat model.
AI_DASHSCOPE_CLASSIFY_MODEL=qwen-flash
AI_DASHSCOPE_TEMPERATURE=0.1
AI_DASHSCOPE_MAX_TOKENS=1024
AI_DASHSCOPE_TIMEOUT_SECONDS=40
# Host only — never append /api/v1 or /compatible-mode/v1 (causes InvalidParameter url error).
AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Optional overrides (normally leave unset). The path is a global fallback; leave it empty when mixing models.
# AI_DASHSCOPE_MULTI_MODEL=true
# AI_DASHSCOPE_COMPLETIONS_PATH=/api/v1/services/aigc/multimodal-generation/generation
AI_TRANSCRIPTION_MODEL=qwen3-asr-flash
# Vision OCR model (not the chat model). Requires VL entitlement on the key.
AI_VISION_MODEL=qwen-vl-plus
# Reserved: supplier invoice inbound API (keep false until a vendor adapter is implemented).
SUPPLIER_INVOICE_INGEST_ENABLED=false
AI_REPORT_RO_USER=orithos_ai_ro
AI_REPORT_RO_PASSWORD=replace-with-a-long-random-password
# Multi-turn chat memory in Redis (threadId-scoped).
AI_CONVERSATION_MEMORY_TURNS=6
AI_CONVERSATION_MEMORY_TTL_MINUTES=120
# Australia / international Model Studio keys:
# Set AI_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com if needed.
# Shopfront crawler staging boundary. Keep disabled until isolated Odoo/test
# company validation is complete; never put the token in source control.
SHOPFRONT_INTEGRATION_ENABLED=false
SHOPFRONT_INTEGRATION_TOKEN=
