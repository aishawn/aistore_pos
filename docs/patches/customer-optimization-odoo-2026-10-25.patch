+import math
+
+from odoo import fields, models
+from odoo.exceptions import AccessError, ValidationError
+
+
+class PosConfig(models.Model):
+    _inherit = "pos.config"
+
+    def orithos_quote_prices(self, quantities, partner_id=False):
+        """Read-only, company-scoped public bridge to Odoo's pricing engine."""
+        self.ensure_one()
+        self.check_access("read")
+        if not self.env.user.has_group("point_of_sale.group_pos_user"):
+            raise AccessError("POS access is required.")
+        allowed = self.env.context.get("allowed_company_ids", [])
+        if self.company_id.id not in allowed or self.company_id not in self.env.user.company_ids:
+            raise AccessError("This register is not available to this company.")
+        config = self.with_company(self.company_id)
+        partner = self.env["res.partner"]
+        if partner_id is not False and (type(partner_id) is not int or partner_id <= 0):
+            raise ValidationError("Invalid customer ID.")
+        if partner_id:
+            partner = partner.browse(partner_id).exists()
+            partner.check_access("read")
+            if len(partner) != 1 or partner.company_id != config.company_id:
+                raise AccessError("Customer is not available to this store.")
+            partner = partner.with_company(config.company_id)
+        customer_list = partner.property_product_pricelist if partner else False
+        pricelist = customer_list or config.pricelist_id
+        if pricelist:
+            pricelist.check_access("read")
+            if not pricelist.active or (pricelist.company_id and pricelist.company_id != config.company_id):
+                raise AccessError("Price list is not available to this store.")
+            if pricelist.currency_id != config.currency_id:
+                raise ValidationError("Price list currency must match the register.")
+        if not isinstance(quantities, list) or not 1 <= len(quantities) <= 80:
+            raise ValidationError("Invalid product quantities.")
+        result = []
+        seen = set()
+        for item in quantities:
+            if not isinstance(item, dict):
+                raise ValidationError("Invalid product quantity.")
+            product_id, quantity = item.get("productId"), item.get("quantity")
+            if type(product_id) is not int or product_id <= 0 or product_id in seen or type(quantity) not in (int, float) or not math.isfinite(quantity) or quantity <= 0:
+                raise ValidationError("Invalid product quantity.")
+            seen.add(product_id)
+            product = self.env["product.product"].with_company(config.company_id).browse(product_id).exists()
+            product.check_access("read")
+            if len(product) != 1 or not product.available_in_pos or (product.company_id and product.company_id != config.company_id):
+                raise AccessError("Product is not available to this store.")
+            price = pricelist._get_product_price(product, quantity, date=fields.Datetime.now()) if pricelist else product.lst_price
+            if not math.isfinite(price) or price < 0:
+                raise ValidationError("Product has no valid price.")
+            result.append({"productId": product_id, "unitPrice": price})
+        return {
+            "prices": result,
+            "pricelistId": pricelist.id if pricelist else False,
+            "priceSource": "customer" if customer_list else "register" if pricelist else "base",
+            "priceSourceName": pricelist.name if pricelist else "Standard price",
+            "currency": config.currency_id.name,
+        }
+
+
+class PartnerCategory(models.Model):
+    _inherit = "res.partner.category"
+
+    company_id = fields.Many2one("res.company", index=True)
