SHOPFRONT_CLIENT_ID=
SHOPFRONT_CLIENT_SECRET=
SHOPFRONT_REDIRECT_URI=http://localhost:8000/oauth/shopfront/callback
SHOPFRONT_SCOPES=run_sales_reports see_products see_history
SHOPFRONT_ENABLE_WEBHOOKS=false
SHOPFRONT_ENABLE_SUPPLY_CHAIN=false
SHOPFRONT_STORES=skr:skr
DATABASE_URL=sqlite:///./data/shopfront_crawler.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SYNC_TIMEZONE=Australia/Adelaide
SYNC_INTERVAL_MINUTES=30
SYNC_DAILY_HOUR=2
SYNC_DAILY_MINUTE=0
WORKER_POLL_SECONDS=2
WORKER_STALE_AFTER_SECONDS=900
SYNC_SALE_COMMIT_BATCH_SIZE=25
SHOPFRONT_SUPPLY_CHAIN_TIMEOUT_SECONDS=900
SHOPFRONT_SUPPLY_CHAIN_INTERVAL_DAYS=7
HISTORY_CHUNK_DAYS=14
SHOPFRONT_HISTORY_START_YEAR=2010
POS_API_BASE_URL=
POS_API_TOKEN=
POS_IMPORT_ENABLED=false
ODOO_API_BASE_URL=
ODOO_API_TOKEN=
ODOO_API_DATABASE=aipos_uat
ODOO_IMPORT_ENABLED=false
ODOO_BUSINESS_WRITE_ENABLED=false
SYNC_LOOKBACK_DAYS=3
SHOPFRONT_PRODUCTS_QUERY={ products(first: 100) { edges { node { id name mdbId status type description image alternateImages createdAt updatedAt deletedAt deleted tempProduct useScales useBarcodeTemplates requestQuantity requestPrice minimumOrderQuantity orderNotes invoiceNotes preventManualDiscounts ignorePriceHostChanges ignoreBarcodeHostChanges category { id name } brand { id name } family { id name } tags { name } trackInventory caseQuantity cost lastCost averageCost globalCost globalLastCost globalAverageCost replacementCost costPercentage prices { quantity price priceEx decimalPlaceLength priceSet { id name } } barcodes { code quantity } taxRate { id name } costTaxRate { id name } inventory { outlet { id name } quantity singleLevel caseLevel reorderLevel reorderLevelSingles reorderLevelCases reorderAmount reorderAmountSingles reorderAmountCases reorderLimit maxQuantity maxQuantitySingles maxQuantityCases onOrder } } } } } }
SHOPFRONT_INVENTORY_QUERY={ products(first: 100) { edges { node { id name mdbId inventory { outlet { id name } quantity singleLevel caseLevel reorderLevel reorderLevelSingles reorderLevelCases reorderAmount reorderAmountSingles reorderAmountCases reorderLimit maxQuantity maxQuantitySingles maxQuantityCases onOrder } } } } }
SHOPFRONT_SALE_DETAIL_QUERY=
# Per-store key returned by Shopfront webhook registration.
SHOPFRONT_WEBHOOK_SIGNING_KEY_SKR=
