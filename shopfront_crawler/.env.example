SHOPFRONT_CLIENT_ID=
SHOPFRONT_CLIENT_SECRET=
SHOPFRONT_REDIRECT_URI=http://localhost:8000/oauth/shopfront/callback
SHOPFRONT_SCOPES=run_advanced_reports run_sales_reports see_products see_history
SHOPFRONT_ENABLE_WEBHOOKS=false
SHOPFRONT_STORES=skr:skr
DATABASE_URL=sqlite:///./data/shopfront_crawler.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SYNC_TIMEZONE=Australia/Adelaide
SYNC_INTERVAL_MINUTES=30
SYNC_DAILY_HOUR=2
SYNC_DAILY_MINUTE=0
HISTORY_CHUNK_DAYS=14
SHOPFRONT_HISTORY_START_YEAR=2010
POS_API_BASE_URL=
POS_API_TOKEN=
POS_IMPORT_ENABLED=false
SYNC_LOOKBACK_DAYS=3
SHOPFRONT_PRODUCTS_QUERY={ products(first: 100) { edges { node { id name status cost globalCost prices { price } barcodes { code } category { name } brand { name } inventory { quantity outlet { id name } } } } } }
SHOPFRONT_INVENTORY_QUERY={ products(first: 100) { edges { node { id name inventory { quantity outlet { id name } } } } } }
SHOPFRONT_SALE_DETAIL_QUERY=
# Per-store key returned by Shopfront webhook registration.
SHOPFRONT_WEBHOOK_SIGNING_KEY_SKR=
