# Unified deployment/debug/trial template. All environments currently use aipos_uat.
RUNTIME_ENVIRONMENT=uat
ODOO_BASE_URL=https://odoo.orithos.com.au
ODOO_DATABASE=aipos_uat
ODOO_DATABASE_UAT=aipos_uat
ISOLATION_ODOO_DATABASE=aipos_uat
POSTGRESQL_URL=postgresql://<uat-user>:<secret>@<private-postgres-host>:5432/<uat-database>
BACKEND_URL=http://backend:8080
INITIAL_ADMIN_PASSWORD=<secret>
ODOO_SERVICE_USERNAME=<least-privilege-service-account>
ODOO_SERVICE_PASSWORD=<secret>
AI_ENABLED=false
AI_COMMANDS_ENABLED=true
# Keep forecasting disabled until SKR backtesting and store review pass.
AI_FORECAST_ENABLED=false
AI_FORECAST_BASE_URL=http://forecast-service:8000
# Keep business writes disabled until isolated Odoo UAT and readback checks pass.
AI_COMMANDS_EXECUTION_ENABLED=false
# Read-only Odoo snapshots feed pricing/replenishment previews.
APP_AI_SNAPSHOT_SYNC_ENABLED=true
AI_REPLENISHMENT_COVERAGE_DAYS=7
AI_REPLENISHMENT_SERVICE_FACTOR=1.65
AI_REPLENISHMENT_CASE_PACK=1
ODOO_ONLY_MODE=true
ODOO_STOCKTAKE_WRITE_ENABLED=false
R2_SYNC_SCHEDULE_ENABLED=false
