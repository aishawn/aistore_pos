# Orithos-native isolated UAT only. Use a dedicated POS PostgreSQL database.
RUNTIME_ENVIRONMENT=uat
# Shared PostgreSQL is allowed for isolated UAT only when exactly one test vendor is allowlisted.
APP_NATIVE_POS_EXPECTED_DATABASE=<exact-current-database-name>
ISOLATION_POS_DATABASE=<exact-current-database-name>
APP_NATIVE_POS_ENABLED_VENDOR_IDS=<single-test-vendor-id>
POSTGRESQL_URL=postgresql://<uat-user>:<secret>@<private-postgres-host>:5432/<exact-current-database-name>
BACKEND_URL=http://backend:8080
POS_REDIS_URL=redis://default:<secret>@<redis-host>:6378
PILOT_BASE_URL=http://127.0.0.1:3300
INITIAL_ADMIN_PASSWORD=<local-secret>
# Remote AI service is enabled for isolated UAT manual verification; keep the
# gateway token in the local ignored .env.uat file or Dokploy secret.
AI_ENABLED=true
AI_PROVIDER=remote
AI_SERVICE_BASE_URL=https://ai.orithos.com.au
AI_SERVICE_TOKEN=<remote-ai-gateway-token>
# Command parsing/preview can be exercised manually; business execution remains off.
AI_COMMANDS_ENABLED=true
AI_COMMANDS_EXECUTION_ENABLED=false
# Enable only for isolated UAT after a fixed snapshot has passed review.
AI_FORECAST_ENABLED=false
AI_FORECAST_BASE_URL=https://ai.orithos.com.au
AI_FORECAST_READ_TIMEOUT_MS=190000
# Enable only for controlled Demo UAT. The host allowlist is mandatory so SKR
# remains read-only even if this flag is accidentally enabled in a shared deployment.
AI_PURCHASE_DRAFT_ENABLED=false
AI_PURCHASE_DRAFT_ALLOWED_HOSTS=demo.orithos.com.au,skr.orithos.com.au
# AI_FORECAST_ENABLED=true  # enable on SKR only after inventoryHistory is FRESH
AI_PURCHASE_CONFIRM_ENABLED=false
AI_REPLENISHMENT_COVERAGE_DAYS=7
AI_REPLENISHMENT_SERVICE_FACTOR=1.65
AI_REPLENISHMENT_CASE_PACK=1
APP_NATIVE_POS_ONLY_MODE=true
