# Dedicated isolated Odoo UAT only. Never point this file at production `aipos`.
ISOLATION_ODOO_DATABASE=aipos_uat
ODOO_DATABASE=aipos_uat
RUNTIME_ENVIRONMENT=uat
BACKEND_URL=http://backend:8080
ODOO_BASE_URL=https://<isolated-odoo-host>
ODOO_MASTER_PASSWORD=<odoo-database-manager-admin-passwd>
UAT_ODOO_ADMIN_USERNAME=<isolated-odoo-admin-login>
UAT_ODOO_ADMIN_PASSWORD=<isolated-odoo-admin-password>
PILOT_BASE_URL=http://127.0.0.1:3300
INITIAL_ADMIN_PASSWORD=<local-secret>
ODOO_SERVICE_USERNAME=<uat-service-account>
ODOO_SERVICE_PASSWORD=<local-secret>
# AI provider is enabled for isolated UAT manual verification; provide the key
# through the local ignored .env.uat file or Dokploy secret, never commit it.
AI_ENABLED=true
AI_DASHSCOPE_API_KEY=<dashscope-key>
# Command parsing/preview can be exercised manually; business execution remains off.
AI_COMMANDS_ENABLED=true
AI_COMMANDS_EXECUTION_ENABLED=false
ODOO_ONLY_MODE=true
R2_SYNC_SCHEDULE_ENABLED=false
